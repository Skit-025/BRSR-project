# ==============================================================================
# MEIL ESG-BRSR Reporting Portal - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
APP_NAME="MEIL ESG-BRSR Reporting Portal"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=45
REFRESH_TOKEN_EXPIRE_DAYS=0

# Database (PostgreSQL 16 with ltree, pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brsr_db

# Redis (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage (Evidence Vault)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meil-evidence-vault
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# AI Gateway & Provider Cascade Architecture
# Hierarchy: OpenRouter (Primary) -> Google Gemini (Secondary) -> Hugging Face (Tertiary)
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
AI_PROVIDER_FALLBACKS=gemini,huggingface

# OpenRouter (PRIMARY — https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_TEXT=openai/gpt-oss-120b
OPENROUTER_MODEL_VISION=google/gemma-3-12b-it

# Google Gemini (SECONDARY — https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_TEXT=gemini-3-flash-preview
AI_MODEL_VISION=gemini-3-flash-preview
AI_EMBEDDING_MODEL=gemini-embedding-001

# Hugging Face Inference Providers (TERTIARY — https://huggingface.co/settings/tokens)
# Requires pre-paid inference credits or PRO subscription. Automatically bypassed on HTTP 402.
HF_API_KEY=your_hugging_face_token_here
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_MODEL_TEXT=openai/gpt-oss-120b
HF_MODEL_TEXT_FALLBACKS=Qwen/Qwen3-32B,meta-llama/Llama-3.3-70B-Instruct,meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_VISION=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_MODEL_VISION_FALLBACKS=meta-llama/Llama-4-Scout-17B-16E-Instruct,zai-org/GLM-4.5V,Qwen/Qwen2.5-VL-7B-Instruct
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
HF_PROVIDER=
HF_MAX_RETRIES=1
HF_TIMEOUT_SECONDS=120
HF_TOTAL_TIMEOUT_SECONDS=150
HF_MAX_TOKENS=4096
HF_TEMPERATURE=0.1

# Circuit Breaker & Safety Fallback
AI_AUTO_FALLBACK_ON_ERROR=True
AI_FALLBACK_TO_MOCK=True
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_PROVIDER_FAILURE_THRESHOLD=2

# SMTP Email Configuration (Google Mail / Gmail Provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=placeholder@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=placeholder@gmail.com
SMTP_FROM_NAME="MEIL AAROHAN Platform"
SMTP_USE_TLS=True
SMTP_USE_SSL=False
FRONTEND_BASE_URL=http://localhost:5173
