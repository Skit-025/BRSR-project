# ==============================================================================
# MEIL ESG-BRSR Reporting Portal - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
APP_NAME="MEIL ESG-BRSR Reporting Portal"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 with ltree, pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brsr_db

# Redis (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage (Evidence Vault)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meil-evidence-vault
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# AI Gateway & Provider Cascade (Gemini -> OpenRouter -> Mock Fallback)
# ------------------------------------------------------------------------------
# Primary Provider ("gemini" or "openrouter")
AI_PROVIDER=gemini

# Google AI Studio (Free API Key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_VISION=gemini-1.5-flash
AI_MODEL_TEXT=gemini-1.5-flash
AI_EMBEDDING_MODEL=models/text-embedding-004

# OpenRouter (Secondary Failover from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_TEXT=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct:free

# Circuit Breaker: Automatically fall back to Mock if live APIs fail/rate-limit
AI_AUTO_FALLBACK_ON_ERROR=True
