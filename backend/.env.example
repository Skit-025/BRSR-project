# ==============================================================================
# MEIL ESG-BRSR Reporting Portal - Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
APP_NAME="MEIL ESG-BRSR Reporting Portal"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1

# Security & Secrets
SECRET_KEY=change_this_to_a_secure_random_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16 with ltree, pgvector)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/brsr_db

# Redis (Caching & Job Queue)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Storage (Evidence Vault)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=meil-evidence-vault
S3_REGION=us-east-1

# ------------------------------------------------------------------------------
# AI Gateway & Provider Cascade (Hugging Face -> OpenRouter -> Gemini -> Mock)
# ------------------------------------------------------------------------------
# Primary Provider + ordered failovers
AI_PROVIDER=huggingface
AI_PROVIDER_FALLBACKS=openrouter,gemini

# Hugging Face Inference Providers (PRIMARY)
# Create a token at https://huggingface.co/settings/tokens
# (fine-grained token with "Make calls to Inference Providers" permission)
# NOTE: HF Inference Providers needs credits or a PRO subscription; with a 0
# balance every call returns HTTP 402 and the gateway falls through to the
# next provider (openrouter) automatically.
HF_API_KEY=your_hugging_face_token_here
HF_ROUTER_BASE_URL=https://router.huggingface.co/v1
HF_MODEL_TEXT=openai/gpt-oss-120b
HF_MODEL_TEXT_FALLBACKS=Qwen/Qwen3-32B,meta-llama/Llama-3.3-70B-Instruct,meta-llama/Llama-3.1-8B-Instruct
HF_MODEL_VISION=Qwen/Qwen3-VL-30B-A3B-Instruct
HF_MODEL_VISION_FALLBACKS=meta-llama/Llama-4-Scout-17B-16E-Instruct,zai-org/GLM-4.5V,Qwen/Qwen2.5-VL-7B-Instruct
HF_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# Leave empty to let the router pick the fastest provider. Optional pin: groq, together, cerebras...
HF_PROVIDER=
HF_MAX_RETRIES=1
HF_TIMEOUT_SECONDS=120
HF_TOTAL_TIMEOUT_SECONDS=150
HF_MAX_TOKENS=4096
HF_TEMPERATURE=0.1

# Google AI Studio (FALLBACK #2 from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_VISION=gemini-flash-latest
AI_MODEL_TEXT=gemini-flash-latest
AI_EMBEDDING_MODEL=gemini-embedding-001

# OpenRouter (FALLBACK #1 from https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL_TEXT=openai/gpt-oss-120b
OPENROUTER_MODEL_VISION=google/gemma-3-12b-it

# Circuit Breaker: Automatically fall back to Mock if live APIs fail/rate-limit
AI_AUTO_FALLBACK_ON_ERROR=True
AI_PROVIDER_COOLDOWN_SECONDS=60
AI_PROVIDER_FAILURE_THRESHOLD=2
